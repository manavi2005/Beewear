# Copy to .env and edit. .env is gitignored (ADR-012). All values are optional —
# the defaults run the full pipeline on SYNTHETIC data with no hardware or keys.

# ─── Source selection (ADR-010) ───────────────────────────────────────────────
# Conversation source: synthetic | replay | bee
ATTUNE_CONVERSATION_SOURCE=synthetic
# Vitals source: synthetic | health_export | api   (api = fed by the companion app)
ATTUNE_VITALS_SOURCE=synthetic

# ─── Product vertical (ADR-022) ───────────────────────────────────────────────
# generic | neurolearn
ATTUNE_VERTICAL=neurolearn

# ─── Bee (only used when a source above is "bee"/live) (ADR-003) ───────────────
# Start the proxy first:  bee login  &&  bee proxy --port 8787
ATTUNE_BEE_PROXY_URL=http://127.0.0.1:8787

# ─── Apple Health export (only used when ATTUNE_VITALS_SOURCE=health_export) ───
# Path to the unzipped export.xml from the Health app (ADR-006).
ATTUNE_HEALTH_EXPORT_PATH=./fixtures/health_export_sample.xml

# ─── Storage (ADR-013) ────────────────────────────────────────────────────────
ATTUNE_DB_PATH=./attune.db

# ─── Alignment (ADR-008/011) ──────────────────────────────────────────────────
# How far on either side of an utterance to look for vitals, in seconds.
ATTUNE_ALIGN_WINDOW_S=45
# Rolling baseline window, in seconds, for "elevated vs. your own baseline".
ATTUNE_BASELINE_WINDOW_S=600

# ─── Coach (ADR-014/017) ──────────────────────────────────────────────────────
# Which engine turns moments into recommendations:
#   template  → deterministic, offline, ZERO cost          (DEFAULT — never charges)
#   ollama    → a local LLM via Ollama, FREE (runs locally; `ollama pull llama3.2`)
#   anthropic → Claude via the Anthropic API, PAID per token (opt-in; needs a key/credits)
ATTUNE_COACH_BACKEND=template
# Max moments handed to the coach per run (also caps spend if you ever use anthropic).
ATTUNE_COACH_MAX_MOMENTS=8

# Only read when ATTUNE_COACH_BACKEND=ollama (free, local):
ATTUNE_OLLAMA_URL=http://127.0.0.1:11434
ATTUNE_OLLAMA_MODEL=llama3.2

# Only read when ATTUNE_COACH_BACKEND=anthropic (PAID — leave commented to stay free):
# ANTHROPIC_API_KEY=sk-ant-...
ATTUNE_COACH_MODEL=claude-opus-5-5

# ─── API service (ADR-009) ────────────────────────────────────────────────────
ATTUNE_API_HOST=127.0.0.1
ATTUNE_API_PORT=8000
